# Copiar a .env y completar. Nunca subir .env a GitHub.
HOST=0.0.0.0
PORT=1337

# Claves de Strapi. Generar cada una con:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# Deben ser IGUALES en EC2 A y EC2 B.
APP_KEYS=cambiar1,cambiar2,cambiar3,cambiar4
API_TOKEN_SALT=cambiar
ADMIN_JWT_SECRET=cambiar
TRANSFER_TOKEN_SALT=cambiar
JWT_SECRET=cambiar
ENCRYPTION_KEY=cambiar

# Base de datos. En local con Docker, compose.yml fuerza DATABASE_HOST=postgres y DATABASE_SSL=false.
# En AWS: endpoint de RDS y DATABASE_SSL=true.
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=novatech
DATABASE_USERNAME=novatech
DATABASE_PASSWORD=novatech
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Nombre de la instancia que se muestra en la tienda ("Atendido por").
SERVIDOR=local
